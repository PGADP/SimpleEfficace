{
  "_comment": "Config du système SIMPLE & EFFICACE (active dès le clone). Gates qualité (simplify_gate, janitor_gate, security_gate, visual_checkpoint) lues par execute-phase.md ; ui_phase/ui_front_pass/ui_safety_gate par ui-phase.md et gsd-ui-checker. Ajuste selon ton projet.",
  "mode": "interactive",
  "granularity": "standard",
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,

    "simplify_gate": true,
    "janitor_gate": true,
    "security_gate": true,
    "visual_checkpoint": true,

    "ui_phase": true,
    "ui_front_pass": true,
    "ui_safety_gate": true
  },
  "parallelization": {
    "enabled": true,
    "plan_level": true,
    "task_level": false,
    "max_concurrent_agents": 3,
    "min_plans_for_parallel": 2
  },
  "gates": {
    "confirm_project": true,
    "confirm_phases": true,
    "confirm_roadmap": true,
    "confirm_breakdown": true,
    "confirm_plan": true,
    "confirm_transition": true,
    "execute_next_plan": true,
    "issues_review": true
  },
  "safety": {
    "always_confirm_destructive": true,
    "always_confirm_external_services": true
  },
  "hooks": {
    "context_warnings": true
  }
}
