{
  "_comment": "SOURCE UNIQUE des patterns de secrets. Lue par se-secret-gate.cjs (BLOQUANT au commit) et par guard-lib.cjs detectSecurity (advisory à l'édition). Les allowPatterns neutralisent les placeholders évidents pour éviter les faux positifs.",
  "patterns": [
    { "id": "openai-anthropic-key", "label": "clé API sk-…", "regex": "\\bsk-[A-Za-z0-9_-]{20,}" },
    { "id": "aws-access-key", "label": "AWS access key (AKIA…)", "regex": "\\bAKIA[0-9A-Z]{16}\\b" },
    { "id": "private-key-block", "label": "clé privée PEM", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
    { "id": "github-token", "label": "token GitHub (ghp_/github_pat_)", "regex": "\\b(ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,})" },
    { "id": "slack-token", "label": "token Slack (xox…)", "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}" },
    { "id": "stripe-key", "label": "clé Stripe live (sk_live_/rk_live_)", "regex": "\\b(sk|rk)_live_[A-Za-z0-9]{20,}" },
    { "id": "supabase-service-role", "label": "JWT service_role Supabase", "regex": "\\beyJ[A-Za-z0-9_-]{30,}\\.[A-Za-z0-9_-]{30,}\\.[A-Za-z0-9_-]{20,}" },
    { "id": "hardcoded-bearer", "label": "Bearer token en dur", "regex": "['\"]Bearer [A-Za-z0-9._~+/-]{25,}={0,2}['\"]" },
    { "id": "generic-assigned-secret", "label": "secret/password/api_key assigné en clair", "regex": "(?:secret|password|passwd|api[_-]?key|access[_-]?token)['\"]?\\s*[:=]\\s*['\"][^'\"\\s]{12,}['\"]" }
  ],
  "allowPatterns": [
    "(?:your|my|dummy|fake|sample|test)[-_]?(?:api[-_]?key|secret|token|password)",
    "xxx+|\\.\\.\\.|<[^>]+>|\\{\\{[^}]+\\}\\}|\\$\\{[^}]+\\}",
    "example|placeholder|changeme|redacted|process\\.env"
  ],
  "excludeFilePatterns": [
    "\\.example(\\.|$)",
    "(^|/)hooks/rules/secret-patterns\\.json$",
    "(^|/)(package-lock\\.json|pnpm-lock\\.yaml|yarn\\.lock)$"
  ]
}
